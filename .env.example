# Copy to .env and adjust. `make dev` does this for you if .env is missing.

# Fuseki admin password. Only guards /$/** (the admin API); data access never
# consults it. Generate one: openssl rand -base64 24
ADMIN_PASSWORD=changeme-local-only

# development | production. Controls link generation (helpers/localLinks.kt).
ENVIRONMENT=development

# Host port for the web app.
WEB_PORT=8080

# SPARQL endpoint auth (only needed when the endpoint is behind HTTP basic auth).
HTTP_AUTH_SPARQL_USER=
HTTP_AUTH_SPARQL_PASSWORD=

# Fuseki ARQ query timeout (ms).
QUERY_TIMEOUT=600000

# Set true to wipe the TDB2 store and reload stack/seed/* on the next `make dev`.
FORCE_SEED=false

# Absolute path to an existing TDB2 store. Setting this makes every dev target run
# against that store instead of the seeded fixtures, with seeding disabled. Leave it
# commented out to work on the fixtures. Required on the server, where PROD=1 uses it.
# NAP_DATA_DIR=/absolute/path/to/nap-web/data

# Resource limits (applied by docker-compose.prod.yml only).
SPARQL_MEM_LIMIT=6g
SPARQL_CPUS=4
WEB_MEM_LIMIT=2g
WEB_CPUS=2

# Host port for the Fuseki UI (override if 3030 is already in use).
FUSEKI_PORT=3030
